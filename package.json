{
  "name": "consenso-ai",
  "version": "2.0.0",
  "private": true,
  "description": "Multi-AI consensus system — 3 experts debate, 1 moderator synthesizes",
  "license": "MIT",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "npm run dev -w apps/worker",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "npm run test -w apps/worker",
    "e2e": "npm run e2e -w apps/worker",
    "deploy": "npm run build && npm run deploy -w apps/worker"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.7.3"
  }
}
